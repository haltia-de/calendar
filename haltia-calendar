#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Календарь: a wall calendar in large type, a month or a whole year.

The month is a classic grid, Monday first: Saturdays, Sundays and the
public holidays of Russia in red, today in a blue circle, the days of the
next and the previous month in grey. ‹ and › (or a swipe) turn the month,
«Сегодня» comes back to it, a tap on the month's name shows the year. A
tap on a day tells what day it is (the weekday, the week of the year, the
holiday); with no day picked the line under the grid sums up the month
(its days, working days and holidays). Nothing to plan and nothing stored:
it only shows dates.
"""
import calendar
import datetime
import os
import sys

import gi
from gi.repository import GLib

APP_ID = "io.github.haltia_de.Calendar"
# Under Wayland GTK 3 names the window by the program name: the program's
# id, as its .desktop file is named, so a desktop or the Haltia shell finds it.
GLib.set_prgname(APP_ID)

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402,F811

MONTHS = ("Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август",
          "Сентябрь", "Октябрь", "Ноябрь", "Декабрь")
MONTHS_OF = ("января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа",
             "сентября", "октября", "ноября", "декабря")
DAYS = ("Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс")
DAY_NAMES = ("понедельник", "вторник", "среда", "четверг", "пятница", "суббота",
             "воскресенье")
# The public holidays fixed in the Labour Code (art. 112). Days moved by
# the government's yearly decree are not known here.
HOLIDAYS = {
    (1, 1): "Новогодние каникулы", (1, 2): "Новогодние каникулы",
    (1, 3): "Новогодние каникулы", (1, 4): "Новогодние каникулы",
    (1, 5): "Новогодние каникулы", (1, 6): "Новогодние каникулы",
    (1, 7): "Рождество Христово", (1, 8): "Новогодние каникулы",
    (2, 23): "День защитника Отечества", (3, 8): "Международный женский день",
    (5, 1): "Праздник Весны и Труда", (5, 9): "День Победы",
    (6, 12): "День России", (11, 4): "День народного единства",
}

CSS = b"""
window, .page { background-color: #e6e6e4; }
headerbar label.title { font-size: 34px; font-weight: bold; color: #2e3436; }
button.nav, button.today, button.monthname {
  background-image: none;
  border: none;
  box-shadow: none;
  border-radius: 16px;
  min-height: 72px;
}
button.nav { background-color: #f2f2f0; color: #2e3436; min-width: 96px; font-size: 34px; }
button.today { background-color: #3584e4; color: #ffffff; font-size: 24px; padding: 0 24px; }
button.monthname { background-color: transparent; color: #2e3436; font-size: 38px;
  font-weight: bold; padding: 0 24px; }
label.wd { font-size: 24px; color: #5e5c64; font-weight: bold; }
label.wd.red { color: #c01c28; }
button.day {
  background-image: none;
  background-color: #f2f2f0;
  border: none;
  box-shadow: none;
  border-radius: 14px;
  font-size: 32px;
  color: #2e3436;
  /* Six weeks of 60 px still leave room for the line under the grid. */
  min-height: 60px;
  padding: 0;
}
button.day.red { color: #c01c28; }
button.day.other { background-color: transparent; color: #9a9996; }
button.day.other.red { color: #e8a0a0; }
button.day.today { background-color: #3584e4; color: #ffffff; font-weight: bold; }
button.day.picked { box-shadow: inset 0 0 0 4px #3584e4; }
label.info { font-size: 26px; color: #2e3436; }
label.info.red { color: #c01c28; }
.mini { background-color: #f2f2f0; border-radius: 16px; padding: 10px; }
.mini label.mname { font-size: 22px; font-weight: bold; color: #2e3436; }
.mini label.mname.now { color: #1c71d8; }
.mini label.d { font-size: 15px; color: #2e3436; }
.mini label.d.red { color: #c01c28; }
.mini label.d.today { color: #ffffff; background-color: #3584e4; border-radius: 10px; }
"""


# Inside the Haltia shell (its session sets XDG_CURRENT_DESKTOP=Haltia:GNOME).
ON_HALTIA = "Haltia" in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")

def holiday(day):
    return HOLIDAYS.get((day.month, day.day))


def red(day):
    return day.weekday() >= 5 or holiday(day) is not None


class Calendar(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.win = None
        today = datetime.date.today()
        self.year, self.month = today.year, today.month
        self.picked = None
        self.mode = "month"
        self.back_action = Gio.SimpleAction.new("back", None)
        self.back_action.set_enabled(False)
        self.back_action.connect("activate", self.on_back)
        self.add_action(self.back_action)

    def on_back(self, _action, _parameter):
        if self.mode == "month":
            self.picked = None
        self.show_month()

    def update_back(self):
        enabled = self.mode == "year" or self.picked is not None
        self.back_action.set_enabled(enabled)
        self.back_btn.set_visible(enabled)

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win = Gtk.ApplicationWindow(application=self, title="Календарь")
        self.win.set_default_size(1160, 800)
        header = Gtk.HeaderBar(title="Календарь")
        # The Haltia shell closes windows with its own button; any other desktop
        # gets the usual window buttons in the header.
        header.set_show_close_button(not ON_HALTIA)
        header.set_decoration_layout(":close")
        back_slot = Gtk.Box()
        back_slot.set_size_request(110, -1)
        self.back_btn = Gtk.Button(label="←")
        self.back_btn.get_style_context().add_class("back")
        self.back_btn.set_action_name("app.back")
        self.back_btn.set_no_show_all(True)
        back_slot.pack_start(self.back_btn, False, False, 0)
        header.pack_start(back_slot)
        self.win.set_titlebar(header)

        self.page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.page.set_border_width(16)
        self.page.get_style_context().add_class("page")
        self.win.add(self.page)
        # A swipe turns the month (or the year).
        self.swipe = Gtk.GestureSwipe(widget=self.page)
        self.swipe.connect("swipe", self.on_swipe)
        self.win.show_all()
        self.show_month()
        # At midnight "today" moves on.
        GLib.timeout_add_seconds(60, self.tick)

    def tick(self):
        today = datetime.date.today()
        if getattr(self, "shown_today", today) != today:
            self.redraw()
        return True

    def clear(self):
        for child in self.page.get_children():
            self.page.remove(child)
            child.destroy()

    def redraw(self):
        if self.mode == "month":
            self.show_month()
        else:
            self.show_year()

    def on_swipe(self, _g, vx, vy):
        if abs(vx) < 400 or abs(vx) < abs(vy):
            return
        self.turn(-1 if vx > 0 else 1)

    def turn(self, step):
        if self.mode == "year":
            self.year += step
            self.show_year()
            return
        self.month += step
        if self.month < 1:
            self.month, self.year = 12, self.year - 1
        elif self.month > 12:
            self.month, self.year = 1, self.year + 1
        self.picked = None
        self.show_month()

    def go_today(self):
        today = datetime.date.today()
        self.year, self.month = today.year, today.month
        self.picked = today
        self.show_month()

    def top_row(self, title, on_title):
        row = Gtk.Box(spacing=12)
        prev = Gtk.Button(label="‹")
        prev.get_style_context().add_class("nav")
        prev.connect("clicked", lambda *_a: self.turn(-1))
        row.pack_start(prev, False, False, 0)
        name = Gtk.Button(label=title)
        name.get_style_context().add_class("monthname")
        name.connect("clicked", lambda *_a: on_title())
        row.pack_start(name, True, True, 0)
        today = Gtk.Button(label="Сегодня")
        today.get_style_context().add_class("today")
        today.connect("clicked", lambda *_a: self.go_today())
        row.pack_start(today, False, False, 0)
        nxt = Gtk.Button(label="›")
        nxt.get_style_context().add_class("nav")
        nxt.connect("clicked", lambda *_a: self.turn(1))
        row.pack_start(nxt, False, False, 0)
        return row

    # --- the month ------------------------------------------------------------
    def show_month(self):
        self.mode = "month"
        self.update_back()
        self.clear()
        today = datetime.date.today()
        self.shown_today = today
        self.page.pack_start(self.top_row("%s %d" % (MONTHS[self.month - 1], self.year),
                                          self.show_year), False, False, 0)
        grid = Gtk.Grid(row_spacing=8, column_spacing=8, column_homogeneous=True,
                        row_homogeneous=True)
        for i, name in enumerate(DAYS):
            label = Gtk.Label(label=name)
            ctx = label.get_style_context()
            ctx.add_class("wd")
            if i >= 5:
                ctx.add_class("red")
            grid.attach(label, i, 0, 1, 1)
        weeks = calendar.Calendar(firstweekday=0).monthdatescalendar(self.year, self.month)
        for r, week in enumerate(weeks, 1):
            for c, day in enumerate(week):
                btn = Gtk.Button(label=str(day.day))
                ctx = btn.get_style_context()
                ctx.add_class("day")
                if day.month != self.month:
                    ctx.add_class("other")
                if red(day):
                    ctx.add_class("red")
                if day == today:
                    ctx.add_class("today")
                if day == self.picked:
                    ctx.add_class("picked")
                btn.connect("clicked", lambda _b, d=day: self.pick(d))
                grid.attach(btn, c, r, 1, 1)
        self.page.pack_start(grid, True, True, 0)
        self.info = Gtk.Label()
        self.info.get_style_context().add_class("info")
        self.info.set_line_wrap(True)
        self.page.pack_start(self.info, False, False, 4)
        self.describe(self.picked or (today if (today.year, today.month) ==
                                      (self.year, self.month) else None))
        if not self.info.get_text():
            self.sum_up()
        self.page.show_all()

    def pick(self, day):
        if day.month != self.month:
            self.year, self.month = day.year, day.month
        self.picked = day
        self.show_month()

    def describe(self, day):
        if not day:
            self.info.set_text("")
            return
        today = datetime.date.today()
        what = "%s, %d %s %d" % (DAY_NAMES[day.weekday()].capitalize(), day.day,
                                 MONTHS_OF[day.month - 1], day.year)
        week = day.isocalendar()[1]
        bits = [what, "%d-я неделя" % week]
        delta = (day - today).days
        if delta == 1:
            bits.append("завтра")
        elif delta == -1:
            bits.append("вчера")
        elif delta > 1:
            bits.append("через %d дн." % delta)
        elif delta < -1:
            bits.append("%d дн. назад" % -delta)
        name = holiday(day)
        if name:
            bits.append(name)
        self.info.set_text(" · ".join(bits))
        ctx = self.info.get_style_context()
        (ctx.add_class if name else ctx.remove_class)("red")

    def sum_up(self):
        """The month in one line: days, working days, days off, holidays."""
        days = [datetime.date(self.year, self.month, d)
                for d in range(1, calendar.monthrange(self.year, self.month)[1] + 1)]
        off = sum(1 for d in days if red(d))
        names = sorted({holiday(d) for d in days if holiday(d)})
        bits = ["%s %d" % (MONTHS[self.month - 1], self.year),
                "%d дн." % len(days), "рабочих %d" % (len(days) - off), "выходных %d" % off]
        bits.extend(names)
        self.info.set_text(" · ".join(bits))
        self.info.get_style_context().remove_class("red")

    # --- the year -------------------------------------------------------------
    def show_year(self):
        self.mode = "year"
        self.update_back()
        self.clear()
        today = datetime.date.today()
        self.shown_today = today
        self.page.pack_start(self.top_row(str(self.year), lambda: None), False, False, 0)
        months = Gtk.Grid(row_spacing=12, column_spacing=12, column_homogeneous=True,
                          row_homogeneous=True)
        cal = calendar.Calendar(firstweekday=0)
        for m in range(1, 13):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.get_style_context().add_class("mini")
            name = Gtk.Label(label=MONTHS[m - 1])
            ctx = name.get_style_context()
            ctx.add_class("mname")
            if (self.year, m) == (today.year, today.month):
                ctx.add_class("now")
            box.pack_start(name, False, False, 0)
            days = Gtk.Grid(column_homogeneous=True, row_spacing=1)
            for r, week in enumerate(cal.monthdatescalendar(self.year, m)):
                for c, day in enumerate(week):
                    label = Gtk.Label(label=str(day.day) if day.month == m else "")
                    lctx = label.get_style_context()
                    lctx.add_class("d")
                    if day.month == m and red(day):
                        lctx.add_class("red")
                    if day == today:
                        lctx.add_class("today")
                    days.attach(label, c, r, 1, 1)
            box.pack_start(days, True, True, 0)
            ev = Gtk.EventBox()
            ev.add(box)
            # A tap opens the month. Returning True from the release would
            # hide it from the page's GestureSwipe, so a drag of more than
            # 30 px is left unhandled and turns the year.
            ev.connect("button-press-event", self.on_mini_press)
            ev.connect("button-release-event",
                       lambda _w, e, mm=m: self.on_mini_release(e, mm))
            months.attach(ev, (m - 1) % 4, (m - 1) // 4, 1, 1)
        self.page.pack_start(months, True, True, 0)
        self.page.show_all()

    def on_mini_press(self, _w, event):
        self._mini_xy = (event.x_root, event.y_root)
        return False

    def on_mini_release(self, event, m):
        at = getattr(self, "_mini_xy", None)
        self._mini_xy = None
        if at is not None:
            dx, dy = event.x_root - at[0], event.y_root - at[1]
            if dx * dx + dy * dy > 30 * 30:
                return False
        self.open_month(m)
        return True

    def open_month(self, m):
        self.month = m
        self.picked = None
        self.show_month()


if __name__ == "__main__":
    sys.exit(Calendar().run(sys.argv))

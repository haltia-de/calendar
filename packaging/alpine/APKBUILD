# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-calendar
pkgver=2.0.5
pkgrel=0
pkgdesc="Календарь: A classic month calendar with Russian holidays (GTK 3)"
url="https://github.com/haltia-de/calendar"
arch="noarch"
# The name before ADR 0004: apk upgrade carries b8k-calendar over to this.
provides="b8k-calendar=$pkgver-r$pkgrel"
replaces="b8k-calendar"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/calendar/archive/v$pkgver.tar.gz"
builddir="$srcdir/calendar-$pkgver"

options="!check"

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"

[Desktop Entry]
Type=Application
Name=Calendar
Name[ru]=Календарь
Comment=A classic month calendar with Russian holidays
Comment[ru]=Классический календарь на месяц с праздниками
Exec=haltia-calendar
Icon=io.github.haltia_de.Calendar
Terminal=false
Categories=GTK;Office;Calendar;Utility;
Keywords=calendar;date;month;календарь;дата;месяц;
StartupNotify=true
X-B8K-Home=true
X-B8K-Replaces=calendar
X-Haltia-Home=true
X-Haltia-Replaces=calendar
X-Flatpak-RenamedFrom=io.github.trudenboy.Calendar.desktop;
